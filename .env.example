# 默认不发起模型调用，不需要密钥。
LLM_PROVIDER=demo
# OpenAI 直连使用 openai，只需配置下方 OPENAI_API_KEY，可选 OPENAI_MODEL。
# 其他实时模型可选 openai-compatible 或 anthropic，以下三项必须配置。
# openai-compatible 的 Base URL 通常包含 /v1；anthropic 填服务根地址或网关前缀。
LLM_BASE_URL=https://your-provider.example
LLM_MODEL=
LLM_API_KEY=
# 可选。同一个网关上的第二个模型，在主模型不可用时尝试。
LLM_SECONDARY_MODEL=
# OpenAI 直连使用此密钥，网关模式也可把它用于备用。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# 单个模型尝试的超时上限，1000–120000 毫秒，默认 30000。整次生成最多 120 秒。
LLM_TIMEOUT_MS=30000
# 仅在网关/模型支持顶层 reasoning_effort 时填写 low、high 或 max；留空不发送。
LLM_REASONING_EFFORT=
# 本地工作台；不要直接暴露到公网。
HOST=127.0.0.1
PORT=5173
